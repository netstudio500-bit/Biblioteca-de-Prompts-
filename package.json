{
  "name": "botia",
  "version": "1.0.2",
  "productName": "BOT.IA",
  "description": "BOT.IA local com integração Ollama",
  "author": "BOT.IA",
  "main": "electron/main.cjs",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "electron .",
    "dist:win": "npm run build && electron-builder --win nsis",
    "dist:dir": "npm run build && electron-builder --win nsis --dir"
  },
  "build": {
    "appId": "com.botia.app",
    "productName": "BOT.IA",
    "icon": "build/icon.svg",
    "artifactName": "BOT.IA-Setup-${version}.${ext}",
    "directories": {"output": "release", "buildResources": "build"},
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "asar": true,
    "removePackageScripts": true,
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BOT.IA",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "BOT.IA-Setup-${version}.${ext}"
    }
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0"
  },
  "dependencies": {}
}
